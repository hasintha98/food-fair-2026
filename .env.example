# Copy to .env — or just run `npm run set-password`, which writes it for you.

# Port the server listens on (serves the dashboard and the API).
PORT=5181

# REQUIRED. Never the password itself — an scrypt hash. Create it with:
#   npm run set-password
DASHBOARD_PASSWORD_HASH=

# REQUIRED. Signs session cookies. 64 hex chars. `set-password` generates one.
SESSION_SECRET=

# How long an unlock lasts.
SESSION_HOURS=24

# The shared Google Sheet.
SHEET_ID=1f_2boP35XvSvzIkiI0IVwnyBItXGbW0J

# Where the built dashboard lives.
STATIC_DIR=../dashboard/dist

# Where the CSV / XLSX exports are written (blank = disabled).
EXPORT_DIR=..

# Set the cookie's Secure flag: auto (only when the request is https), true, false.
COOKIE_SECURE=auto

# Brute-force protection on /api/login.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
