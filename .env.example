# Copy to .env — or just run `npm run set-password`, which writes it for you.

# Port the server listens on (serves the dashboard and the API).
PORT=5181

# REQUIRED. Never the password itself — an scrypt hash. Create it with:
#   npm run set-password
DASHBOARD_PASSWORD_HASH=

# REQUIRED. Signs session cookies. 64 hex chars. `set-password` generates one.
SESSION_SECRET=

# How long an unlock lasts.
SESSION_HOURS=24

# The shared Google Sheet.
SHEET_ID=1f_2boP35XvSvzIkiI0IVwnyBItXGbW0J

# Where the built dashboard lives.
STATIC_DIR=../dashboard/dist

# Where the CSV / XLSX exports are written (blank = disabled).
EXPORT_DIR=..

# Set the cookie's Secure flag: auto (only when the request is https), true, false.
COOKIE_SECURE=auto

# Brute-force protection on /api/login.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Only if the FRONTEND is hosted on a different origin (e.g. Vercel). Comma-
# separated list of exact origins allowed to call this API with cookies:
#   CORS_ORIGIN=https://foodfair.vercel.app
# Setting this switches the session cookie to SameSite=None; Secure, which
# browsers only accept over https — so the API must then be behind TLS.
CORS_ORIGIN=

# Read the sheet automatically at startup when no cached plan exists. Keep this
# on for hosts with ephemeral disks (Railway, Render…) or the first visitor
# after every deploy sees "not synced yet" until someone presses Refresh.
SYNC_ON_START=true
